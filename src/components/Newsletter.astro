---
const endpoint = import.meta.env.PUBLIC_NEWSLETTER_FORM_URL;
---

<section class="newsletter" aria-labelledby="newsletter-title">
  <div>
    <span class="eyebrow">A little closer to Croatia</span>
    <h2 id="newsletter-title">Good stories. In your inbox.</h2>
    <p>
      Guides, new conversations and a connection to Croatia, wherever you are.
    </p>
  </div>
  <div>
    {endpoint ? (
      <form action={endpoint} method="post">
        <label for="newsletter-email">Your email address</label>
        <div class="form-row">
          <input
            type="email"
            name="email"
            id="newsletter-email"
            placeholder="you@example.com"
            required
            autocomplete="email"
          />
          <button class="button" type="submit">
            Subscribe ↗
          </button>
        </div>
        <label>
          <input
            type="checkbox"
            name="consent"
            value="yes"
            required
            style="width:auto"
          />{' '}
          I agree to receive the newsletter.
        </label>
        <p class="form-note">
          Unsubscribe whenever you like. Your details go to our newsletter
          provider.
        </p>
      </form>
    ) : (
      <>
        <p>
          <strong>The newsletter is coming soon.</strong>
          <br />
          In the meantime, follow the channels or add our RSS feed to your
          reader.
        </p>
        <a
          class="text-link"
          href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/rss.xml`}
        >
          Follow the RSS feed →
        </a>
      </>
    )}
  </div>
</section>
