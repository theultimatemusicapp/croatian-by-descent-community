---
import CostEvidence from '../../components/CostEvidence.astro';
import { costEvidence } from '../../data/cost-evidence';
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { cityGuides } from '../../data/city-guides';
import Card from '../../components/Card.astro';
import { places, slugify, href } from '../../data/site';
import { publishedArticles } from '../../data/articles';
import { videos } from '../../data/videos';
export function getStaticPaths() {
  return places.map((name) => ({
    params: { city: slugify(name) },
    props: { name },
  }));
}
const { name } = Astro.props;
const cityEntry = (await getCollection('cities')).find(
  (c) => c.data.name === name,
)!;
const guide = cityGuides.find((g) => g.name === name)!;
const articles = (await publishedArticles()).filter(
  (a) => a.data.location === name,
);
const relatedVideos = videos.filter((v) => v.location === name);
const regionalLocations: Record<string, string[]> = {
  'Continental Croatia': ['Zagreb', 'Samobor', 'Slavonia'],
  Zagreb: ['Samobor'],
  Dalmatia: ['Split', 'Zadar', 'Dubrovnik', 'Trogir', 'Šibenik', 'Korčula'],
  Kvarner: ['Rijeka'],
};
const localInterviews = (await publishedArticles()).filter(
  (a) =>
    a.data.type === 'interview' &&
    (a.data.location === name ||
      regionalLocations[name]?.includes(a.data.location || '')),
);
const topics = guide.topics;
const prices = costEvidence.find((g) => g.slug === guide.slug)!;
const photo =
  name === 'Zadar'
    ? 'coast'
    : name === 'Dubrovnik'
      ? 'town'
      : name === 'Istria'
        ? 'inland'
        : null;
---

<Base
  title={`${name}: living, housing & local life`}
  description={cityEntry.data.description}
  noindex={cityEntry.data.sample}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        ['Home', href()],
        ['Cities & Regions', href('cities-and-regions/')],
        [name, Astro.url.pathname],
      ].map(([title, path], i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: title,
        item: new URL(path, Astro.site).href,
      })),
    },
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href()}>Home</a> /{' '}
    <a href={href('cities-and-regions/')}>Cities & Regions</a> /{' '}
    <span>{name}</span>
  </nav>
  <header class="page-header">
    <span class="eyebrow">Find your corner of Croatia</span>
    <h1>Living in {name}</h1>
    <p>{cityEntry.data.description}</p>
    <span class="meta">
      Last updated: {cityEntry.data.updatedDate.toISOString().slice(0, 10)}
      {cityEntry.data.sample ? ' · Guide framework' : ''}
    </span>
  </header>
  {photo && (
    <figure class="article-image">
      <img
        src={href('images/' + photo + '.webp')}
        alt={
          name === 'Istria'
            ? 'Rovinj harbour in Istria'
            : `${name} and the Adriatic Sea`
        }
        width="1440"
        height="960"
      />
      <figcaption>
        <a href={href('image-credits/')}>Image credits and licence</a>
      </figcaption>
    </figure>
  )}
  <div class="two-column">
    <section>
      <div class="city-guide-content">
        <div class="prose city-introduction">
          {guide.intro.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
        </div>
        {topics.map((topic) => (
          <details class="check-details city-topic" id={slugify(topic.title)}>
            <summary>{topic.title}</summary>
            <div class="prose city-topic-body">
              {['Cost of living', 'Rental prices'].includes(topic.title) && (
                <CostEvidence
                  rows={prices.rows}
                  place={name}
                  category={
                    topic.title === 'Rental prices' ? 'rent' : 'utilities'
                  }
                />
              )}
              {topic.paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
              {topic.bullets.length > 0 && (
                <ul>
                  {topic.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )}
              <div class="city-topic-sources">
                <h3>Sources and local services</h3>
                <ul>
                  {topic.sources.map((source) => (
                    <li>
                      <a href={source.url}>{source.label} ↗</a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </details>
        ))}
      </div>
      <section class="section">
        <h2>Local interviews</h2>
        {localInterviews.length ? (
          localInterviews.map((article) => (
            <p style="margin-top:18px">
              <a
                class="text-link"
                href={href('articles/' + article.data.slug + '/')}
              >
                {article.data.title} — {article.data.location}
              </a>
            </p>
          ))
        ) : (
          <p style="margin-top:18px">
            We are inviting residents and returnees to share their experiences
            of {name}.
          </p>
        )}
        <a class="text-link" href={href('contact/?type=Interview%20request')}>
          Share your experience of {name} →
        </a>
      </section>
    </section>
    <aside>
      <div class="start-box">
        <span class="eyebrow">Explore the area</span>
        <h2>Map of {name}</h2>
        <p>
          Explore neighbourhoods, nearby towns and the journeys you would make
          from a potential home.
        </p>
        <a
          class="text-link"
          href={`https://www.openstreetmap.org/search?query=${encodeURIComponent(name + ', Croatia')}`}
        >
          Open OpenStreetMap ↗
        </a>
      </div>
      <div class="section">
        <h3>Related videos</h3>
        {relatedVideos.length ? (
          relatedVideos.map((v) => (
            <p>
              <a class="text-link" href={href('videos/' + v.slug + '/')}>
                {v.title}
              </a>
            </p>
          ))
        ) : (
          <p>Approved local videos will appear here.</p>
        )}
        <a class="text-link" href={href('videos/')}>
          Visit the video library →
        </a>
      </div>
    </aside>
  </div>
  <section class="section" style="margin-bottom:50px">
    <div class="section-heading">
      <h2>Related articles</h2>
    </div>
    {articles.length ? (
      <div class="grid3">
        {articles.map((a) => (
          <Card article={a} />
        ))}
      </div>
    ) : (
      <p>
        Continue planning with{' '}
        <a class="text-link" href={href('articles/moving-to-croatia/')}>
          our moving guide
        </a>{' '}
        and{' '}
        <a class="text-link" href={href('articles/renting-in-croatia/')}>
          rental checklist
        </a>
        .
      </p>
    )}
  </section>
</Base>
