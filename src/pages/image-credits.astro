---
import Base from '../layouts/Base.astro';
import credits from '../data/image-credits.json';
import { href } from '../data/site';
---

<Base title="Image credits & licences">
  <header class="page-header">
    <span class="eyebrow">The people behind the photographs</span>
    <h1>Image credits</h1>
    <p>
      Real photographs, credited to their creators. These images are used under
      the licences below.
    </p>
  </header>
  <div class="grid3" style="margin-bottom:50px">
    {credits.map((c) => (
      <article class="card">
        <img
          src={href(c.localFile)}
          alt={c.caption}
          width="720"
          height="450"
          loading="lazy"
        />
        <h2 style="font-size:1.8rem">{c.caption}</h2>
        <p>
          By{' '}
          <a class="text-link" href={c.creatorUrl}>
            {c.creator}
          </a>
        </p>
        <p>
          <a class="text-link" href={c.sourceUrl}>
            Original on Wikimedia Commons ↗
          </a>
        </p>
        <p>
          <a class="text-link" href={c.licenseUrl}>
            {c.license}
          </a>{' '}
          · Downloaded {c.downloadDate}
        </p>
        <p>{c.changes}</p>
      </article>
    ))}
  </div>
  <p class="form-note" style="margin-bottom:40px">
    Photographs accompanying general guides are illustrative of Croatia, not
    evidence of a reported event. Zadar, Dubrovnik and Rovinj are identified in
    their captions. Approved YouTube thumbnails, when present, identify the
    linked videos and remain subject to YouTube and creator rights.
  </p>
</Base>
