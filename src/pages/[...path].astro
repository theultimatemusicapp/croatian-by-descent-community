---
import Base from '../layouts/Base.astro';
import Card from '../components/Card.astro';
import Newsletter from '../components/Newsletter.astro';
import { sections, places, slugify, href, channels } from '../data/site';
import { publishedArticles } from '../data/articles';
import { videos, youtubeId } from '../data/videos';
export function getStaticPaths() {
  return sections.flatMap((section) => [
    { params: { path: section.slug }, props: { section, topic: '' } },
    ...section.topics.map((topic) => ({
      params: { path: section.slug + '/' + slugify(topic) },
      props: { section, topic },
    })),
  ]);
}
interface Props {
  section: (typeof sections)[number];
  topic: string;
}
const { section, topic } = Astro.props;
const all = await publishedArticles();
const articles = all.filter(
  (a) =>
    (a.data.category === section.slug ||
      (section.slug === 'moving-to-croatia' &&
        a.data.slug === 'buying-property-in-croatia') ||
      (section.slug === 'property' && a.data.slug === 'renting-in-croatia') ||
      (section.slug === 'croatian-diaspora' &&
        a.data.tags.some((t) => section.topics.includes(t)))) &&
    (!topic ||
      a.data.tags.includes(topic) ||
      (topic === 'Buying property' &&
        a.data.slug === 'buying-property-in-croatia') ||
      (topic === 'Renting property' && a.data.slug === 'renting-in-croatia')),
);
const title = topic || section.title;
const url = new URL(Astro.url.pathname, Astro.site).href;
const crumbs = [
  { name: 'Home', item: new URL(href(), Astro.site).href },
  ...(topic
    ? [
        {
          name: section.title,
          item: new URL(href(section.slug + '/'), Astro.site).href,
        },
      ]
    : []),
  { name: title, item: url },
];
const topicNotes: Record<string, string> = {
  'Who may qualify':
    'Identify the legal basis that fits your circumstances with the competent authority. A family connection is a starting point for investigation, not confirmation of eligibility.',
  'Croatian ancestry':
    'Build a documented family line. Record names, name changes, places and dates, and distinguish family recollection from official records.',
  Documents:
    'Create a document inventory before ordering records. Confirm the exact list and accepted formats with the authority handling your application.',
  'Birth certificates':
    'Ask the relevant registry how to obtain the version required for your application. Check that names and dates align across generations.',
  'Marriage certificates':
    'Record marriages and surname changes that connect the family line. Confirm which certificates and versions the receiving authority needs.',
  Apostilles:
    'Ask whether legalisation is required for each document and whether an applicable agreement changes the process. Do this before paying for an apostille.',
  Translations:
    'Confirm what form of Croatian translation is accepted and who is qualified to provide it before commissioning the work.',
  'Consulates and applications':
    'Confirm the competent mission, appointment process and submission instructions directly with the Croatian consular service.',
  'Common delays':
    'Keep a dated submission record and copies of requests for additional information. Avoid relying on another applicant’s timeline as a promise.',
  'Common mistakes':
    'Check name variants, missing links between generations and outdated assumptions about requirements. Ask for clarification rather than guessing.',
  'Passport after approval':
    'Citizenship approval and a passport application are separate steps. Ask the authority which registrations and documents must be completed next.',
  'Personal application stories':
    'Verified application stories will appear here after the participant has approved the account. Personal outcomes are not legal precedents.',
  'Property scams':
    'Verify who is authorised to act, inspect the property and ask an independent lawyer to review documents before paying. Urgency is a reason to slow down.',
  Renovations:
    'Get an independent condition assessment, check permissions and request written scopes from appropriate professionals before committing to a schedule.',
  Inheritance:
    'Ask a qualified lawyer to review the estate, ownership records and the law that applies to your circumstances. Family recollection is not a substitute for documentation.',
  'Taxes and fees':
    'Request current, dated advice on the costs of your specific transaction. This section does not publish unsourced rates or prices.',
  'Long-term rental issues':
    'Confirm that the written term covers the period you need, including the tourist season, and establish the process for repairs, deposits and notice.',
  'Regional comparisons':
    'Compare equivalent properties using dated sources, the same intended use and similar condition. Asking prices alone cannot establish value.',
};
---

<Base
  title={title}
  description={
    topic
      ? `${topic}: explore ${section.title.toLowerCase()} with Croatian By Descent Community.`
      : section.intro
  }
  noindex={!!topic && articles.length === 0}
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        ...c,
      })),
    },
  ]}
>
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href()}>Home</a>
    <span>/</span>
    {topic && (
      <>
        <a href={href(section.slug + '/')}>{section.title}</a>
        <span>/</span>
      </>
    )}
    <span>{title}</span>
  </nav>
  <header class="page-header">
    <span class="eyebrow">
      {topic ? section.title : 'Explore Croatian By Descent'}
    </span>
    <h1>{title}</h1>
    <p>
      {topic
        ? topicNotes[topic] ||
          `A space for carefully sourced ${topic.toLowerCase()} guides and stories. This section will grow as original reporting is reviewed and published.`
        : section.intro}
    </p>
  </header>
  {section.topics.length > 0 && (
    <nav class="topic-list" aria-label={`${section.title} topics`}>
      <a class:list={{ active: !topic }} href={href(section.slug + '/')}>
        All
      </a>
      {section.topics.map((t) => (
        <a
          class:list={{ active: topic === t }}
          href={href(section.slug + '/' + slugify(t) + '/')}
        >
          {t}
        </a>
      ))}
    </nav>
  )}
  {section.slug === 'cities-and-regions' && (
    <>
      <div class="grid3">
        {places.map((p) => (
          <article class="start-box">
            <span class="eyebrow">City & region guide</span>
            <h2>
              <a href={href('cities-and-regions/' + slugify(p) + '/')}>{p} ↗</a>
            </h2>
            <p>
              Housing, transport, lifestyle and the questions to ask before
              choosing your next chapter.
            </p>
          </article>
        ))}
      </div>
    </>
  )}
  {section.slug === 'citizenship-by-descent' && (
    <>
      <aside class="notice">
        <strong>Last reviewed: 10 September 2026.</strong> Rules can change.
        General information only; verify your case with the competent authority
        or a qualified professional.
      </aside>
      <p>
        <a
          class="text-link"
          href="https://mup.gov.hr/aliens-281621/citizenship/281629"
        >
          Official citizenship guidance ↗
        </a>{' '}
        ·{' '}
        <a
          class="text-link"
          href="https://konzularniportal.mvep.hr/services/4/17?lang=en"
        >
          Croatian consular portal ↗
        </a>
      </p>
      <div class="band" style="margin-bottom:35px">
        <div>
          <span class="eyebrow">Research your roots</span>
          <h2>Start with the family connection.</h2>
          <p>
            Our introductory guide covers ancestry, documents, translations,
            applications and the steps after approval.
          </p>
          <a
            class="text-link"
            href={href('articles/croatian-citizenship-by-descent/')}
          >
            Read the starting guide →
          </a>
        </div>
        <div>
          <h3>A useful related resource</h3>
          <p>
            Continue your research at Croatian By Descent, and confirm
            requirements against official Croatian sources.
          </p>
          <a class="text-link" href="https://croatianbydescent.com/">
            croatianbydescent.com ↗
          </a>
        </div>
      </div>
    </>
  )}
  {section.slug === 'property' && (
    <aside class="notice">
      <strong>Last reviewed: 10 September 2026.</strong> Property, tax and legal
      rules can change. General information only. Obtain independent
      professional advice and consult{' '}
      <a href="https://gov.hr/en">Croatian government services</a>. No unsourced
      current prices are published here.
    </aside>
  )}
  {section.slug === 'videos' && (
    <>
      <div
        class="channel-grid"
        style="background:var(--ink);color:white;padding:25px;margin-bottom:32px"
      >
        {channels.map((c) => (
          <div class="channel">
            <span class="play" aria-hidden="true">
              ▶
            </span>
            <div>
              <h3>
                <a href={c.url}>{c.name} ↗</a>
              </h3>
              <p>{c.detail}</p>
            </div>
          </div>
        ))}
      </div>
      {videos.length > 0 ? (
        <>
          <label for="video-search">Search approved videos</label>
          <input
            id="video-search"
            class="search-input"
            type="search"
            placeholder="Search title, category or location…"
          />
          <div class="grid3">
            {videos.map((v) => (
              <article
                class="card"
                data-video-search={`${v.title} ${v.category} ${v.location}`.toLowerCase()}
              >
                <a href={href('videos/' + v.slug + '/')}>
                  <img
                    src={`https://i.ytimg.com/vi/${youtubeId(v.youtubeUrl)}/hqdefault.jpg`}
                    alt={`Video thumbnail: ${v.title}`}
                    width="480"
                    height="360"
                    loading="lazy"
                  />
                  <span class="eyebrow">
                    {v.channel} · {v.category}
                  </span>
                  <h3>{v.title}</h3>
                  <p>{v.description}</p>
                  <span class="meta">
                    {v.location} · {v.date.toISOString().slice(0, 10)}
                  </span>
                </a>
              </article>
            ))}
          </div>
          <p id="video-empty" hidden>
            No videos match that search.
          </p>
        </>
      ) : (
        <div class="empty">
          <h2>The video library is taking shape.</h2>
          <p>
            No videos have been approved for this library yet. Explore the
            channels above while Carl selects the first collection.
          </p>
        </div>
      )}
    </>
  )}
  {articles.length > 0 && (
    <section class="section" style="margin-bottom:35px">
      <div class="section-heading">
        <h2>{topic ? 'In this topic' : 'Guides & stories'}</h2>
      </div>
      <div class="grid3">
        {articles.map((a) => (
          <Card article={a} />
        ))}
      </div>
    </section>
  )}
  {articles.length === 0 &&
    section.slug !== 'videos' &&
    section.slug !== 'cities-and-regions' && (
      <div class="empty">
        <h2>
          {section.slug === 'croatia-news'
            ? 'Reporting comes before publishing.'
            : 'Your story could help someone start theirs.'}
        </h2>
        <p>
          {section.slug === 'croatia-news'
            ? 'No reported stories have been published in this category yet. Background explainers are available on the main news page.'
            : 'Verified stories and detailed guides will be added after editorial review. We welcome relevant story and interview proposals.'}
        </p>
        <a class="text-link" href={href('contact/')}>
          Contact the community →
        </a>
      </div>
    )}
  {section.slug === 'interviews' && (
    <div class="notice">
      Explore the guide to preparing a diaspora family interview. Recorded
      conversations will be added as participants approve their stories.{' '}
      <a href={href('contact/?type=Interview%20request')}>
        Propose an interview →
      </a>
    </div>
  )}
  <Newsletter />
</Base>
<script>
  document.getElementById('video-search')?.addEventListener('input', (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let count = 0;
    document
      .querySelectorAll<HTMLElement>('[data-video-search]')
      .forEach((el) => {
        el.hidden = !el.dataset.videoSearch?.includes(q);
        if (!el.hidden) count++;
      });
    const empty = document.getElementById('video-empty');
    if (empty) empty.hidden = count > 0;
  });
</script>
