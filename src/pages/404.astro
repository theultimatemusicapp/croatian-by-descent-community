---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
---

<Base title="Page not found" noindex={true}>
  <section class="page-header" style="margin:70px 0 100px">
    <span class="eyebrow">404 · A small detour</span>
    <h1>Let’s find your way back.</h1>
    <p>That page may have moved, or the address may be incomplete.</p>
    <a class="button" href={href()}>
      Back to the community →
    </a>{' '}
    <a class="button outline" href={href('search/')}>
      Search articles
    </a>
  </section>
</Base>
