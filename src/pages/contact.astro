---
import Base from '../layouts/Base.astro';
import { href } from '../data/site';
const endpoint = import.meta.env.PUBLIC_CONTACT_FORM_URL;
const types = [
  'Interview request',
  'Story submission',
  'Correction',
  'Partnership enquiry',
  'Advertising enquiry',
];
---

<Base title="Contact & community submissions">
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href={href()}>Home</a> / Contact
  </nav>
  <header class="page-header">
    <span class="eyebrow">The community starts with a conversation</span>
    <h1>Tell us your story.</h1>
    <p>
      A family connection. A fresh start. A local perspective. We’d love to make
      room for yours.
    </p>
  </header>
  <div class="two-column" style="margin-bottom:55px">
    <div>
      {!endpoint && (
        <aside class="notice">
          <strong>Submissions are not open yet.</strong>
          <p>
            The form below shows what we’ll ask when the service opens. It does
            not collect or send any information. Follow Carl’s channels in the
            meantime.
          </p>
        </aside>
      )}
      <form class="contact-form" action={endpoint || undefined} method="post">
        <fieldset disabled={!endpoint}>
          <legend class="sr-only">Contact details</legend>
          <label for="enquiry-type">What would you like to share?</label>
          <select name="type" id="enquiry-type">
            {types.map((t) => (
              <option>{t}</option>
            ))}
          </select>
          <label for="name">Your name</label>
          <input
            id="name"
            name="name"
            required
            maxlength="120"
            autocomplete="name"
          />
          <label for="email">Email address</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            autocomplete="email"
          />
          <label for="location">Location or country (optional)</label>
          <input id="location" name="location" maxlength="150" />
          <label for="message">Your message</label>
          <textarea
            id="message"
            name="message"
            required
            minlength="20"
            maxlength="8000"
            placeholder="Tell us a little about the story, question or correction…"
          ></textarea>
          <label>
            <input type="checkbox" required name="consent" value="yes" /> I
            agree to my details being used to respond to this enquiry.
          </label>
          <p class="form-note">
            Please don’t send passports, certificates, financial records or
            other sensitive documents. Read our{' '}
            <a href={href('privacy/')}>privacy information</a>.
          </p>
          <button class="button" type="submit">
            {endpoint ? 'Send enquiry ↗' : 'Submissions opening soon'}
          </button>
        </fieldset>
      </form>
    </div>
    <aside>
      <div class="start-box">
        <span class="eyebrow">What makes a useful proposal?</span>
        <h2>Your experience. In your words.</h2>
        <p>
          Share the broad topic, where it happened and what another reader could
          learn. An initial proposal doesn’t need to be a finished article.
        </p>
        <p>
          For corrections, include the article title, the detail in question and
          a reliable source.
        </p>
      </div>
      <div class="section">
        <span class="eyebrow">Partnerships & advertising</span>
        <p>
          Tell us about the organisation, the proposed collaboration and why it
          is relevant to the community. Commercial relationships will be
          disclosed.
        </p>
        <a class="text-link" href={href('editorial-policy/')}>
          Read our editorial policy →
        </a>
      </div>
    </aside>
  </div>
</Base>
<script>
  const t = new URLSearchParams(location.search).get('type');
  const select = document.getElementById('enquiry-type') as HTMLSelectElement;
  if (t && Array.from(select.options).some((o) => o.value === t))
    select.value = t;
</script>
